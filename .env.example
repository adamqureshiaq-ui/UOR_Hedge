# Copy this file to .env for local development (`cp .env.example .env`) and fill in your keys.
# .env is in .gitignore: never commit real keys. On Render, set these in the service's Environment tab.

# Alpaca market data (paper trading keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Signs login tokens. Locally the built-in default is fine; in production use a long random value (generate with command below):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Leave unset locally (uses sqlite:///./database.db). In production: the Neon connection string.
# DATABASE_URL=

# --- Production only (Render) ---
# ENVIRONMENT=production   # makes the server refuse to start with unsafe settings
# CORS_ORIGINS=https://your-site.pages.dev   # the frontend's address(es), comma-separated